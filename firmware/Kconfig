# L.I.M.A. Firmware Configuration

source "Kconfig.zephyr"

config LIMA_MAIN_LOG_LEVEL
    int "LIMA main log level"
    default 3
    range 0 4

config LIMA_FSM_LOG_LEVEL
    int "LIMA FSM log level"
    default 3
    range 0 4

config LIMA_CRYPTO_LOG_LEVEL
    int "LIMA crypto log level"
    default 3
    range 0 4

config LIMA_DEEP_SLEEP_INTERVAL_MS
    int "Deep sleep wakeup interval (ms)"
    default 120000

config LIMA_BARO_THRESHOLD_PA
    int "Barometric pressure breach threshold in Pascals"
    default 5

config LIMA_CRYPTO_KEY_ID
    hex "PSA persistent key slot ID for LIMA signing key"
    default 0x00000001

config LIMA_BLE_LOG_LEVEL
    int "LIMA BLE log level"
    default 3
    range 0 4

config LIMA_BLE_ADV_DURATION_MS
    int "BLE advertisement duration (ms)"
    default 500

config LIMA_PROVISION_UNIX_TIME
    int "RTC provisioning timestamp (Unix epoch, 0 = disabled)"
    default 0

config LIMA_RTC_LOG_LEVEL
    int "LIMA RTC log level"
    default 3

config LIMA_FORCE_PROVISION
    bool "Force-write provisioning epoch to DS3231 and NVS on boot"
    default n

config LIMA_CRYPTO_AES_KEY_ID
	int "PSA persistent key slot ID for AES-256-GCM encryption key"
	default 2
	help
	  PSA ITS key slot for the AES-256 pre-shared key used for
	  GCM encryption of (LER || inner_sig) in the LIMA Frame (LF).
	  Must not conflict with CONFIG_LIMA_CRYPTO_KEY_ID (default 1).
	  On first boot the key is generated, logged in hex, and persisted.
	  Operator captures the hex from serial log and stores in Bitwarden.